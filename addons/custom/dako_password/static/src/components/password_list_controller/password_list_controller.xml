<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dako_password.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-additional-actions">
                <button type="button"
                        class="btn btn-secondary o_dako_list_btn"
                        t-on-click="onToggleAll">
                    <i t-att-class="visState.showAll ? 'fa fa-eye-slash me-1' : 'fa fa-eye me-1'"/>
                    <t t-esc="visState.showAll ? 'Ocultar todas' : 'Mostrar todas'"/>
                </button>
                <button type="button"
                        class="btn btn-secondary o_dako_list_btn ms-2"
                        t-on-click="onClickExport">
                    <i class="fa fa-file-excel-o me-1"/>
                    <span>Exportar Excel</span>
                </button>
            </t>
        </xpath>
    </t>

</templates>

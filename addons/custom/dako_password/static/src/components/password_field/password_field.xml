<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dako_password.PasswordField">
        <div class="o_dako_password_field d-inline-flex align-items-center w-100" t-ref="root">
            <t t-if="isReadonly">
                <span class="o_dako_password_value flex-grow-1 text-truncate" t-esc="displayValue" title=""/>
            </t>
            <t t-else="">
                <input
                    class="o_input o_dako_password_input flex-grow-1"
                    t-att-type="isVisible ? 'text' : 'password'"
                    t-att-value="value"
                    t-on-input.stop="onInput"
                    placeholder="••••••••"
                    autocomplete="new-password"
                    title=""/>
            </t>
            <button type="button"
                    class="btn btn-link btn-sm o_dako_password_btn"
                    t-on-mousedown.stop=""
                    t-on-click="onToggleClick"
                    t-att-title="isVisible ? 'Ocultar' : 'Mostrar'">
                <i t-att-class="isVisible ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
            </button>
            <button type="button"
                    class="btn btn-link btn-sm o_dako_password_btn"
                    t-on-mousedown.stop=""
                    t-on-click="onCopyClick"
                    title="Copiar">
                <i class="fa fa-clipboard"/>
            </button>
            <button t-if="!isReadonly"
                    type="button"
                    class="btn btn-link btn-sm o_dako_password_btn"
                    t-on-mousedown.stop=""
                    t-on-click="onGenerate"
                    title="Generar contraseña">
                <i class="fa fa-magic"/>
            </button>
        </div>
    </t>

</templates>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dako_password_form" model="ir.ui.view">
        <field name="name">dako.password.form</field>
        <field name="model">dako.password</field>
        <field name="arch" type="xml">
            <form string="Contraseña">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ej. AWS Producción"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vault_id" options="{'no_create_edit': True}"/>
                            <field name="username" placeholder="usuario@empresa.com"/>
                            <field name="password" widget="dako_password" required="1"/>
                            <field name="url" widget="url" placeholder="https://..."/>
                        </group>
                        <group>
                            <field name="strength" widget="badge"
                                   decoration-danger="strength == 'weak'"
                                   decoration-warning="strength == 'medium'"
                                   decoration-success="strength == 'strong'"/>
                            <field name="strength_score" widget="progressbar"/>
                        </group>
                    </group>
                    <group string="Nota">
                        <field name="note" nolabel="1"
                               placeholder="Notas internas, preguntas de seguridad, observaciones..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dako_password_tree" model="ir.ui.view">
        <field name="name">dako.password.list</field>
        <field name="model">dako.password</field>
        <field name="arch" type="xml">
            <list string="Contraseñas" js_class="dako_password_list">
                <field name="name"/>
                <field name="vault_id"/>
                <field name="username"/>
                <field name="password" widget="dako_password"/>
                <field name="url" widget="url"/>
                <field name="strength" widget="badge"
                       decoration-danger="strength == 'weak'"
                       decoration-warning="strength == 'medium'"
                       decoration-success="strength == 'strong'"/>
                <field name="note" optional="hide"/>
                <field name="create_uid" optional="show"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dako_password_search" model="ir.ui.view">
        <field name="name">dako.password.search</field>
        <field name="model">dako.password</field>
        <field name="arch" type="xml">
            <search string="Buscar contraseñas">
                <field name="name"/>
                <field name="vault_id"/>
                <field name="username"/>
                <field name="url"/>
                <filter string="Débiles" name="weak" domain="[('strength', '=', 'weak')]"/>
                <filter string="Medias" name="medium" domain="[('strength', '=', 'medium')]"/>
                <filter string="Fuertes" name="strong" domain="[('strength', '=', 'strong')]"/>
                <group name="group_by">
                    <filter string="Vault" name="group_vault" context="{'group_by': 'vault_id'}"/>
                    <filter string="Fortaleza" name="group_strength" context="{'group_by': 'strength'}"/>
                    <filter string="Creador" name="group_creator" context="{'group_by': 'create_uid'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dako_password" model="ir.actions.act_window">
        <field name="name">Todas las contraseñas</field>
        <field name="res_model">dako.password</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dako_password_search"/>
        <field name="context">{'search_default_group_vault': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva contraseña
            </p>
            <p>
                Solo verás las contraseñas de los vaults a los que tenés acceso.
            </p>
        </field>
    </record>

</odoo>

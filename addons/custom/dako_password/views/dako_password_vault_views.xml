<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dako_password_vault_form" model="ir.ui.view">
        <field name="name">dako.password.vault.form</field>
        <field name="model">dako.password.vault</field>
        <field name="arch" type="xml">
            <form string="Vault">
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_open_passwords" icon="fa-key">
                            <field name="password_count" widget="statinfo" string="Contraseñas"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ej. Ventas, Servidores, Marketing"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Usuarios autorizados" name="users">
                            <field name="user_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <p class="text-muted mt-2">
                                Solo los usuarios listados podrán ver, editar o crear contraseñas dentro de este vault.
                            </p>
                        </page>
                        <page string="Descripción" name="description">
                            <field name="description" placeholder="Notas internas sobre este vault..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dako_password_vault_kanban" model="ir.ui.view">
        <field name="name">dako.password.vault.kanban</field>
        <field name="model">dako.password.vault</field>
        <field name="arch" type="xml">
            <kanban class="o_dako_vault_kanban" sample="1" highlight_color="color">
                <field name="password_count"/>
                <templates>
                    <t t-name="card">
                        <main class="d-flex flex-column">
                            <div class="d-flex align-items-center mb-2">
                                <a type="object" name="action_open_passwords"
                                   class="o_kanban_record_title fw-bold fs-5 text-truncate">
                                    <field name="name"/>
                                </a>
                            </div>
                            <footer class="d-flex align-items-center justify-content-between">
                                <a type="object" name="action_open_passwords" class="btn btn-link p-0">
                                    <i class="fa fa-key me-1" role="img" aria-label="Contraseñas"/>
                                    <field name="password_count"/> contraseñas
                                </a>
                                <field name="user_ids" widget="many2many_avatar_user"/>
                            </footer>
                        </main>
                    </t>
                    <t t-name="menu">
                        <a type="edit" class="dropdown-item" role="menuitem">Editar vault</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dako_password_vault_tree" model="ir.ui.view">
        <field name="name">dako.password.vault.tree</field>
        <field name="model">dako.password.vault</field>
        <field name="arch" type="xml">
            <list string="Vaults">
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags" optional="show"/>
                <field name="password_count"/>
            </list>
        </field>
    </record>

    <record id="action_dako_password_vault" model="ir.actions.act_window">
        <field name="name">Vaults</field>
        <field name="res_model">dako.password.vault</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo vault
            </p>
            <p>
                Un vault agrupa contraseñas del mismo equipo, proyecto o cliente.
                Solo los usuarios autorizados podrán acceder a su contenido.
            </p>
        </field>
    </record>

</odoo>

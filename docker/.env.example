# ============================================================================
#  Variables de entorno del stack MPRepuestos. Copiar a `.env` y completar.
#  El archivo `.env` real NO se versiona (ver .gitignore).
# ============================================================================

# Red Docker EXISTENTE del NGINX Proxy Manager en este VPS.
# (Confirmada con `docker network ls` → nginx_default)
NPM_NETWORK=nginx_default

# Dominio que enrutará el NPM hacia este Odoo (configurar el Proxy Host en el NPM;
# el DNS del dominio debe apuntar al VPS). No se usa dentro de los contenedores.
DOMAIN=odoo.ejemplo.com.ar

# Tag de la imagen propia
TAG=19-mprepuestos

# --- PostgreSQL ---
# POSTGRES_DB = base de mantenimiento (el rol se crea como superusuario).
# La base de la APLICACIÓN es DB_NAME y la crea Odoo en el primer arranque.
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CAMBIAME_postgres_fuerte

# --- Odoo ---
DB_NAME=mprepuestos
# Master password (gestión de bases). Fuerte y secreto. NO es el login del usuario.
ODOO_MASTER_PASSWD=CAMBIAME_master_fuerte
# Usuario de la aplicación (lo que se pide para entrar a la UI).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Puertos publicados al host (acceso directo IP:puerto). Dejar vacío para no publicar.
HTTP_PORT=8069
GEVENT_PORT=8072
